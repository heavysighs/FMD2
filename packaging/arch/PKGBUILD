# Maintainer: FMD2 Linux Port <fmd2@localhost>
# Builds from the working tree; release builds should pin a source tarball
# in source=()/sha256sums=() here (pinned third-party deps live in
# scripts/build-deps.sh — commit-sha pinned, see tasks T006/T016, research R5).
pkgname=fmd2
pkgver=2.0.34.5
pkgrel=1
pkgdesc="Free Manga Downloader 2 - manage and download manga from various websites"
arch=('x86_64')
url="https://github.com/dazedcat19/FMD2"
license=('GPL-2.0-only')
depends=('qt6pas' 'sqlite' 'openssl' 'pcre2' 'libwebp' 'brotli' 'zstd' 'lua54' 'duktape' '7zip' 'hicolor-icon-theme')
makedepends=('fpc' 'lazarus' 'git')
optdepends=('imagemagick: image conversion and thumbnailling')
source=()
sha256sums=()

_src() { echo "$startdir/../.."; }

build() {
  cd "$(_src)"
  ./scripts/build-deps.sh
  lazbuild --lazarusdir=/usr/lib/lazarus --build-mode=Linux --widgetset=qt6 mangadownloader/md.lpi
}

package() {
  local src="$(_src)"
  cd "$src"

  # binary + external debug symbols (binary keeps a .gnu_debuglink to fmd.dbg)
  install -Dm755 bin/x86_64-linux/fmd "$pkgdir/usr/lib/fmd2/fmd"
  install -Dm644 bin/x86_64-linux/fmd.dbg "$pkgdir/usr/lib/fmd2/fmd.dbg"

  # launcher + desktop entry + icons
  install -Dm755 packaging/arch/fmd "$pkgdir/usr/bin/fmd"
  install -Dm644 packaging/arch/fmd2.desktop "$pkgdir/usr/share/applications/fmd2.desktop"
  local size
  for size in 48 64 128 256; do
    install -Dm644 "packaging/arch/icons/hicolor/${size}x${size}/apps/fmd2.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/fmd2.png"
  done

  # read-only program files (FMD_DIRECTORY, set by the launcher)
  install -dm755 "$pkgdir/usr/share/fmd2"
  cp -a images languages lua "$pkgdir/usr/share/fmd2/"
  install -Dm644 changelog.txt "$pkgdir/usr/share/fmd2/changelog.txt"
  install -Dm644 readme.rtf "$pkgdir/usr/share/fmd2/readme.rtf"

  # licenses
  install -Dm644 license.txt "$pkgdir/usr/share/licenses/fmd2/license.txt"
  install -Dm644 licenses/THIRD-PARTY-LICENSE.txt "$pkgdir/usr/share/licenses/fmd2/THIRD-PARTY-LICENSE.txt"
}
